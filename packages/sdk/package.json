{
  "name": "@vizier/sdk",
  "version": "0.3.1",
  "description": "Thin TypeScript client for the Vizier verification API.",
  "license": "MIT",
  "author": "Vassiliy Lakhonin",
  "homepage": "https://github.com/vassiliylakhonin/vizier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vassiliylakhonin/vizier.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ai",
    "agents",
    "security",
    "authorization",
    "guardrails",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  }
}
