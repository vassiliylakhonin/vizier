{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vizier",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["VIZIER_API_KEY", "AGENT_CARD_SIGNING_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
