{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vizier",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "VIZIER_API_KEY",
      "AGENT_CARD_SIGNING_KEY",
      "RECEIPT_SIGNING_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // Two endpoints answer without a credential: evaluation-only A2A, and
  // evaluation-only MCP since the registry listing made /mcp discoverable by
  // design. Both run the full deterministic kernel per request, so the bound
  // here is CPU. Authenticated integrations are bounded by credential issuance
  // and are not counted against this limiter.
  "ratelimits": [
    {
      "name": "ANONYMOUS_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vizier-audit",
      "database_id": "d243bf9e-7a5f-42cf-86fe-53fe7cfd5672"
    }
  ]
}
